# Multi-platform Dockerfile for Automan Car Purchase System
# Supports both linux/amd64 and linux/arm64 architectures

FROM --platform=$BUILDPLATFORM eclipse-temurin:17-jdk as backend-builder

# Set working directory
WORKDIR /app

# Copy Gradle files
COPY gradlew .
COPY gradle gradle
COPY build.gradle.kts .
COPY settings.gradle.kts .
COPY gradle.properties .
COPY copy-kotlin-dependencies.sh .

# Copy source code
COPY src src

# Make gradlew executable
RUN chmod +x gradlew

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Build the backend
RUN ./gradlew build

# Copy the built JAR file
RUN cp build/libs/automan-backend-1.0-SNAPSHOT.jar app.jar

# Frontend build stage
FROM --platform=$BUILDPLATFORM eclipse-temurin:17-jdk as frontend-builder

WORKDIR /app

# Copy Gradle files
COPY gradlew .
COPY gradle gradle
COPY build.gradle.kts .
COPY settings.gradle.kts .
COPY gradle.properties .

# Copy source code
COPY src src

# Make gradlew executable
RUN chmod +x gradlew && chmod +x copy-kotlin-dependencies.sh

# Build the frontend
RUN ./gradlew jsBrowserProductionWebpack && ./copy-kotlin-dependencies.sh

# Final multi-platform image
FROM --platform=$TARGETPLATFORM eclipse-temurin:17-jdk

# Install required packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy backend JAR from builder
COPY --from=backend-builder /app/app.jar app.jar

# Copy frontend build from builder
COPY --from=frontend-builder /app/build/dist/js/productionExecutable /usr/share/nginx/html

# Copy nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Create startup script
RUN echo '#!/bin/bash\n\
# Start MySQL\n\
service mysql start\n\
\n\
# Wait for MySQL to be ready\n\
while ! mysqladmin ping -h"localhost" --silent; do\n\
    echo "Waiting for MySQL..."\n\
    sleep 2\n\
done\n\
\n\
# Initialize database with sample data\n\
mysql -u root -e "CREATE DATABASE IF NOT EXISTS automan_car_purchase;"\n\
mysql -u root -e "CREATE USER IF NOT EXISTS '\''automan_user'\''@'\''localhost'\'' IDENTIFIED BY '\''automan_password'\'';"\n\
mysql -u root -e "GRANT ALL PRIVILEGES ON automan_car_purchase.* TO '\''automan_user'\''@'\''localhost'\'';"\n\
mysql -u root -e "FLUSH PRIVILEGES;"\n\
\n\
# Import database schema and migrations\n\
mysql -u root automan_car_purchase < /app/01-init-multiplatform.sql\n\
mysql -u root automan_car_purchase < /app/02-car-brand-mapping.sql\n\
mysql -u root automan_car_purchase < /app/03-booking-mappings.sql\n\
mysql -u root automan_car_purchase < /app/04-rixo-prices.sql\n\
mysql -u root automan_car_purchase < /app/10-clients-table.sql\n\
mysql -u root automan_car_purchase < /app/11-events-table.sql\n\
mysql -u root automan_car_purchase < /app/12-users-table.sql\n\
\n\
# Start backend in background\n\
java -jar app.jar &\n\
\n\
# Start nginx in foreground\n\
nginx -g "daemon off;"' > /app/start.sh

RUN chmod +x /app/start.sh

# Copy database migration scripts
COPY database/01-init-multiplatform.sql /app/01-init-multiplatform.sql
COPY database/02-car-brand-mapping.sql /app/02-car-brand-mapping.sql
COPY database/03-booking-mappings.sql /app/03-booking-mappings.sql
COPY database/04-rixo-prices.sql /app/04-rixo-prices.sql
COPY database/10-clients-table.sql /app/10-clients-table.sql
COPY database/11-events-table.sql /app/11-events-table.sql
COPY database/12-users-table.sql /app/12-users-table.sql

# Expose ports
EXPOSE 8080 8083 3306

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# Start the application
CMD ["/app/start.sh"]