# Multi-stage Docker build for complete Automan system
FROM node:18-alpine AS frontend-builder

# Set working directory
WORKDIR /app

# Copy frontend source
COPY src src
COPY build.gradle.kts settings.gradle.kts gradle.properties copy-kotlin-dependencies.sh ./
COPY gradlew ./
COPY gradle gradle

# Make gradlew executable
RUN chmod +x gradlew && chmod +x copy-kotlin-dependencies.sh

# Build frontend
RUN ./gradlew jsBrowserProductionWebpack && ./copy-kotlin-dependencies.sh

# Backend builder stage
FROM openjdk:17-jdk-slim AS backend-builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy backend source
COPY backend/src backend/src
COPY backend/build.gradle.kts backend/settings.gradle.kts backend/gradle.properties backend/
COPY backend/gradlew backend/
COPY backend/gradle backend/gradle

# Make gradlew executable
RUN chmod +x gradlew

# Build backend
RUN ./gradlew build -x test

# Final stage - complete system
FROM openjdk:17-jdk-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    nginx \
    mysql-server \
    phpmyadmin \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy backend JAR
COPY --from=backend-builder /app/build/libs/automan-backend-1.0-SNAPSHOT.jar app.jar

# Copy frontend build
COPY --from=frontend-builder /app/build/dist/js/productionExecutable /usr/share/nginx/html

# Copy database initialization script (consolidated)
COPY database/01-init-multiplatform.sql /docker-entrypoint-initdb.d/01-init-multiplatform.sql

# Copy nginx configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Create startup script
RUN echo '#!/bin/bash\n\
# Start MySQL\n\
service mysql start\n\
\n\
# Wait for MySQL to start\n\
sleep 10\n\
\n\
# Initialize database\n\
mysql -u root -e "CREATE DATABASE IF NOT EXISTS automan_car_purchase;"\n\
mysql -u root -e "CREATE USER IF NOT EXISTS automan_user@localhost IDENTIFIED BY \"automan_password\";"\n\
mysql -u root -e "GRANT ALL PRIVILEGES ON automan_car_purchase.* TO automan_user@localhost;"\n\
mysql -u root -e "FLUSH PRIVILEGES;"\n\
\n\
# Import database schema and migrations (MySQL will execute files in /docker-entrypoint-initdb.d/ automatically)\n\
# Files are executed in alphabetical order: 01, 02, 03, 04, 10, 11, 12\n\
\n\
# Start nginx\n\
service nginx start\n\
\n\
# Start backend application\n\
java -jar app.jar &\n\
\n\
# Keep container running\n\
tail -f /dev/null' > /app/start.sh && chmod +x /app/start.sh

# Expose ports
EXPOSE 80 8083 3306

# Set environment variables
ENV SPRING_PROFILES_ACTIVE=docker
ENV SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/automan_car_purchase?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ENV SPRING_DATASOURCE_USERNAME=automan_user
ENV SPRING_DATASOURCE_PASSWORD=automan_password

# Start the complete system
CMD ["/app/start.sh"]