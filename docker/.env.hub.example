# Copy to docker/.env on the server. Do not commit real passwords or keys.
DOCKERHUB_USERNAME=your-dockerhub-username
AUTOMAN_IMAGE_TAG=release-commit-sha
RDS_ENDPOINT=your-rds-host.region.rds.amazonaws.com
RDS_USERNAME=automan_user
RDS_PASSWORD=your-rds-password
APP_FRONTEND_URL=https://your-public-site
APP_VERIFICATION_BASE_URL=https://your-public-site/api
# Optional. Leave unset until that integration is used.
# APP_MAIL_ADMIN_EMAIL=
# RESEND_API_KEY=
# GMAIL_USERNAME=
# GMAIL_APP_PASSWORD=
# R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
