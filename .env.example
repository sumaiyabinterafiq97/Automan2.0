# Copy to .env and set values. Used by docker-compose for backend email (admin approval flow).
# Resend: create API key at https://resend.com/api-keys (use onboarding@resend.dev as sender for testing).

RESEND_API_KEY=your-resend-api-key

# Optional: defaults shown
# APP_MAIL_ADMIN_EMAIL=automan.dev.team@gmail.com
# APP_MAIL_FROM=Automan <onboarding@resend.dev>
# APP_VERIFICATION_BASE_URL=http://localhost:8083/api
# APP_FRONTEND_URL=http://localhost:8080
# APP_MAIL_VALIDATE_MX=true

# Cloudflare R2 (car pictures) — set R2_ENABLED=true and fill credentials for local R2 uploads
# R2_ENABLED=true
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=from-r2-api-token
# R2_SECRET_ACCESS_KEY=from-r2-api-token
# R2_BUCKET_NAME=automan-car-pictures-prod
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
