# Reliable image for Docker Hub / AWS: build the JAR on the host (uses your Gradle cache & network),
# then package only the runtime.
#
#   cd backend && ./gradlew build -x test
#   docker build --platform linux/amd64 -f Dockerfile.prebuilt -t YOUR_USER/automan-backend:latest .
#   docker push YOUR_USER/automan-backend:latest
#
ARG JAVA_BASE_IMAGE=eclipse-temurin:17-jre-jammy
FROM ${JAVA_BASE_IMAGE}
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY build/libs/automan-backend-1.0-SNAPSHOT.jar app.jar
EXPOSE 8083
ENV SPRING_PROFILES_ACTIVE=docker
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -f "http://localhost:${PORT:-8083}/api/actuator/health" || exit 1
CMD ["java", "-jar", "app.jar"]
