# Development Dockerfile for Kotlin JS frontend with hot reloading
FROM node:18-alpine

# Install Java and other dependencies
RUN apk add --no-cache openjdk17-jdk curl

# Set working directory
WORKDIR /app

# Copy Gradle wrapper and build files
COPY gradlew .
COPY gradle gradle
COPY build.gradle.kts .
COPY settings.gradle.kts .
COPY gradle.properties .

# Make gradlew executable
RUN chmod +x gradlew

# Install webpack dev server globally for hot reloading
RUN npm install -g webpack webpack-cli webpack-dev-server

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080 || exit 1

# Start development server with hot reloading
CMD ["./gradlew", "jsBrowserDevelopmentWebpack", "--continuous"]
