# Copy to .env.railway.backup (gitignored). Used by scripts/backup-railway-mysql.sh
# and scripts/restore-railway-mysql.sh.
#
# Railway dashboard → MySQL service → Variables tab:
#   Use the PUBLIC TCP proxy host/port (not mysql.railway.internal).
#   MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE (often "railway" for DB name).

RAILWAY_MYSQL_HOST=switchyard.proxy.rlwy.net
RAILWAY_MYSQL_PORT=12345
RAILWAY_MYSQL_USER=root
RAILWAY_MYSQL_PASSWORD=your-password-from-railway
RAILWAY_MYSQL_DATABASE=railway
