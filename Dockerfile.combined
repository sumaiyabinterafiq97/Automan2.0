# Combined Docker image using existing images
FROM automan20-backend:latest

# Install nginx and mysql
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    nginx \
    mysql-server \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy frontend from the frontend image
COPY --from=automan20-frontend:latest /usr/share/nginx/html /usr/share/nginx/html

# Copy database initialization
COPY database/init.sql /docker-entrypoint-initdb.d/

# Copy nginx configuration
COPY nginx-single.conf /etc/nginx/conf.d/default.conf

# Create startup script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "🚗 Starting Automan Car Purchase Management System..."\n\
\n\
# Start MySQL\n\
service mysql start\n\
\n\
# Wait for MySQL to start\n\
echo "⏳ Waiting for MySQL to start..."\n\
sleep 15\n\
\n\
# Initialize database\n\
echo "📦 Initializing database..."\n\
mysql -u root -e "CREATE DATABASE IF NOT EXISTS automan_car_purchase;"\n\
mysql -u root -e "CREATE USER IF NOT EXISTS automan_user@localhost IDENTIFIED BY \"automan_password\";"\n\
mysql -u root -e "GRANT ALL PRIVILEGES ON automan_car_purchase.* TO automan_user@localhost;"\n\
mysql -u root -e "FLUSH PRIVILEGES;"\n\
\n\
# Import database schema\n\
mysql -u root automan_car_purchase < /docker-entrypoint-initdb.d/init.sql\n\
\n\
# Start nginx\n\
echo "🌐 Starting nginx..."\n\
service nginx start\n\
\n\
# Start backend application\n\
echo "🔧 Starting backend application..."\n\
java -jar app.jar &\n\
\n\
# Wait for backend to start\n\
echo "⏳ Waiting for backend to start..."\n\
sleep 30\n\
\n\
echo "🎉 System is ready!"\n\
echo "=================================="\n\
echo "📱 Access Points:"\n\
echo "   • Main Application: http://localhost:80"\n\
echo "   • Backend API: http://localhost:8083/api"\n\
echo "   • Database: localhost:3306"\n\
echo ""\n\
echo "🔑 Login Credentials:"\n\
echo "   • Email: admin@gmail.com"\n\
echo "   • Password: admin123"\n\
echo "=================================="\n\
\n\
# Keep container running\n\
tail -f /dev/null' > /app/start.sh && chmod +x /app/start.sh

# Expose ports
EXPOSE 80 8083 3306

# Set environment variables
ENV SPRING_PROFILES_ACTIVE=docker
ENV SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/automan_car_purchase?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ENV SPRING_DATASOURCE_USERNAME=automan_user
ENV SPRING_DATASOURCE_PASSWORD=automan_password

# Start the complete system
CMD ["/app/start.sh"]
